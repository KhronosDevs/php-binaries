# --- Build script artifacts (khronos-static-build) ---
# Everything here is regenerated by running ./build.sh — nothing in these
# paths should ever be committed.

# Working directory: downloaded tarballs, extracted sources, static deps
/work/

# Final build output (the compiled php7/ bundle)
/dist/

# In case someone builds in-place inside php-src instead of $WORK_DIR
php-src/
ext-pmmpthread/

# Common build byproducts if anyone runs make outside the expected dirs
*.o
*.lo
*.la
*.a
*.so
*.so.*
bin.zip
Makefile
config.log
config.status
autom4te.cache/

# Editor/OS cruft
.DS_Store
*.swp
